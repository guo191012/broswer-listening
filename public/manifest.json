{
  "manifest_version": 3,
  "name": "Vibcoding Request Monitor",
  "short_name": "Vibcoding Monitor",
  "version": "0.1.0",
  "description": "在任意网站注入浮动入口, 监听并记录特定接口请求, 打印到 console 与侧边面板。",
  "minimum_chrome_version": "116",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Vibcoding Request Monitor",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png", "flash.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
